# URL pública usada para canonical, sitemap y Open Graph. No es un secreto.
SITE_URL=https://www.buholex.com

# PostgreSQL transaction connection URL (runtime)
DATABASE_URL=

# PostgreSQL session connection URL (migrations)
DATABASE_MIGRATION_URL=

# Credencial exclusiva del administrador complaints_admin_login. No usar fallbacks.
DATABASE_ADMIN_URL=

# Auth0 Authentication (Requerido para BúhoLex Administrativo)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=
DATABASE_AUTHORIZATION_URL=

# Credencial exclusiva del administrador complaints_admin_read_login.
DATABASE_ADMIN_READ_URL=

# Credencial exclusiva del administrador complaints_admin_detail_read_login.
DATABASE_ADMIN_DETAIL_READ_URL=