{
  "name": "buholex-v2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/integration/**",
    "test:integration:complaints": "vitest run -c vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate:staging": "node --env-file-if-exists=.env.local scripts/complaints-migrate-staging.mjs",
    "db:migrate:production": "node scripts/complaints-migrate-production.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "15.5.9",
    "postgres": "^3.4.9",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.9",
    "jsdom": "27.2.0",
    "typescript": "5.9.3",
    "vitest": "4.0.14",
    "vitest-axe": "0.1.0"
  }
}
